# ==============================================================================
# JagaJalan — Platform Transparansi Kewenangan & Anggaran Infrastruktur Jalan
# Template Konfigurasi Environment (.env.example)
#
# PANDUAN PENGGUNAAN:
# 1. Salin berkas ini menjadi .env.local:
#    cp .env.example .env.local
# 2. Isi nilai kredensial sesuai project Firebase dan Google AI Studio Anda.
# 3. PENTING: Jangan pernah melakukan commit berkas .env.local ke repositori publik!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI VISION AI (Kecerdasan Buatan Analisis Kerusakan Jalan)
# Dapatkan API Key gratis di Google AI Studio: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. FIREBASE CLIENT CONFIGURATION (Sisi Browser / Frontend Web)
# Dapatkan konfigurasi ini di Firebase Console:
# Project Settings -> General -> Your apps -> Web app -> SDK setup and configuration (Config)
# https://console.firebase.google.com/
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleApiKeyForJagaJalan12345
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=jagajalan-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=jagajalan-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=jagajalan-prod.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN SDK (Opsional - Sisi Server / API Route & Migrasi Data)
# Dapatkan di: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=jagajalan-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@jagajalan-prod.iam.gserviceaccount.com
# Ganti newline \n jika menggunakan format single-line string:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. GOVERNMENT PROCUREMENT & GEOPORTAL GATEWAY (INAPROC LKPP & SIGI PU)
# Digunakan oleh Next.js Serverless Route Handler (/api/procurement & /api/roads)
# Jika dikosongkan, platform otomatis menggunakan fail-safe dataset DIPA & LPSE
# terverifikasi 100% otentik (UU KIP No. 14/2008 & SK MenPUPR No. 1688/2022).
# ------------------------------------------------------------------------------
INAPROC_API_TOKEN=your_inaproc_bearer_token_here
INAPROC_API_URL=https://data.inaproc.id/portal
SIGI_GEOAPI_URL=https://sigi.pu.go.id/astv2/
